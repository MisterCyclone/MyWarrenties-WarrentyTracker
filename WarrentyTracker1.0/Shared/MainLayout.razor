@inherits LayoutComponentBase
@inject StateContainer StateContainer;
@inject NavigationManager NavManager;
<div class="page">
	@*added color to the sidebar*@
	<div  class="sidebar">
		<NavMenu />
	</div>
	@*added a about page on the top row*@
	<main>
		<div class="top-row px-4">
			<NavLink class= "nav-link"href="/about">About</NavLink>
			<button class="nav-link" @onclick='logOut'>Logout</button>
		</div>

		<article class="content px-4">
			@Body
		</article>
	</main>
</div>
@code {
	public void logOut()
	{
		StateContainer.CurrentUser = null;
		NavManager.NavigateTo("/");
	}
}